#: newtypedlg.cpp:25
#, kde-format
msgid "Create New File Type"
msgstr "Crea un tipus de fitxer nou"

#: newtypedlg.cpp:30
#, kde-format
msgid "Group:"
msgstr "Grup:"

#: newtypedlg.cpp:39
#, kde-format
