<article id="history" lang="&language;">
<title
>الشريط الجانبي للتاريخ</title>
<articleinfo>
<authorgroup>
<author
>&Burkhard.Lueck;</author>
<othercredit role="translator"
><firstname
>زايد</firstname
><surname
>السعيدي</surname
