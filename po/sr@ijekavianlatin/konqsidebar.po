#: history_module/kcmhistory.cpp:54
#, kde-format
msgid ""
"Action to carry out when opening an URL from history:<dl><dl><dt>Auto:</"
"dt><dd>opens the URL in a new tab unless the current tab is empty or an "
"intro page</dd><dt>Open URL in a new tab:</dt><dd>always opens the URL in a "
"new tab</dd><dt>Open URL in current tab:</dt><dd>always opens the URL in the "
"current tab</dd><dt>Open URL in new window:</dt><dd>always opens the URL in "
"a new window</dd></dl>"
msgstr ""
"Radnja koja se izvodi pri otvaranju URL iz istorijata:<dl><dl><dt>Automatski:"
"</dt><dd>otvara URL u novom jezičku, osim ako je tekući jezičak prazan ili "
"uvodna stranica</dd><dt>Otvori u novom jezičku:</dt><dd>uvijek otvara URL u "
"novom jezičku</dd><dt>Otvori u tekućem jezičku:</dt><dd>uvijek otvara URL u "
"tekućem jezičku</dd><dt>Otvori u novom prozoru:</dt><dd>uvijek otvara URL u "
"novom prozoru</dd></dl></dl>"

