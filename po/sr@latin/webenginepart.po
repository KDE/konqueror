#. i18n: ectx: property (title), widget (QGroupBox, groupBox_2)
#: kcms/permissions/permissions.ui:20
#, kde-format
msgid "Persistent permission policy"
msgstr "Smernica trajnih dozvola"

#. i18n: ectx: property (toolTip), widget (QComboBox, defaultPermissionPolicy)
#: kcms/permissions/permissions.ui:33
#, kde-format
msgid ""
"<html><head/><body><p>What to do when a page requires a permission:</p>\n"
"<ul>\n"
"<li><strong>ask every time</strong>: ask every time the page requires the "
"permission whether to grant or deny permission</li>\n"
"<li><strong>only ask once per session</strong>: only ask the first time the "
"page requires the permission, then reuse the same answer until Konqueror is "
"closed</li>\n"
"<li><strong>only ask once</strong>: only ask the first time the page "
"requires the permission, then reuse the same answer</li>\n"
"</ul>\n"
"<p><strong>Note:</strong> for security reasons, some permissions (for "
"example, permission to access microphones or webcams) are always asked every "
"time, regardless of this setting.</p>\n"
"</body></html>"
msgstr ""
"<html><head/><body><p>Šta uraditi kada stranica zatraži dozvolu:</p>\n"
"<ul>\n"
"<li><strong>pitaj svaki put</strong>: pita svaki put kada stranica zatraži "
"dozvolu da li je treba dati ili odbiti</li>\n"
"<li><strong>pitaj samo jednom po sesiji</strong>: pita samo prvi put kada "
"stranica zatraži dozvolu, a zatim isti odgovor ponovo koristi dok se "
"K‑osvajač ne zatvori</li>\n"
"<li><strong>pitaj samo jednom</strong>: pita samo prvi put kada stranica "
"zatraži dozvolu, a zatim isti odgovor ponovo koristi</li>\n"
"</ul>\n"
"<p><strong>Napomena:</strong> iz bezbednosnih razloga, za neke dozvole (na "
"primer, za pristup mikrofonima ili veb kamerama) uvek se pita svaki put, bez "
"obzira na ovu postavku.</p>\n"
"</body></html>"

