#. i18n: ectx: property (toolTip), widget (QLineEdit, userAgentString)
#: useragent/useragent.ui:185
#, kde-format
msgid ""
"<html><head/><body><p>The browser identification to use when the default "
"identification is disabled.</p><p>You can enter it manually or start from "
"one in the list below and change it according to your needs.</p></body></"
"html>"
msgstr ""
"<html><head/><body><p>Identifikacija pregledača koja se koristi kada je "
"podrazumevana identifikacija isključena.</p><p>Možete je uneti ručno ili "
"početi od neke sa spiska ispod i izmeniti je po potrebi.</p></body></html>"

#. i18n: ectx: property (toolTip), widget (QCheckBox, useDefaultUA)
#: useragent/useragent.ui:201
#, kde-format
msgid ""
"<html><head/><body><p>If checked, disable choosing a custom identification "
"and use the default one</p></body></html>"
msgstr ""
"<html><head/><body><p>Ako je ovo popunjeno, izbor posebne identifikacije se "
"isključuje i koristi se podrazumevana</p></body></html>"

#. i18n: ectx: property (text), widget (QCheckBox, useDefaultUA)
#: useragent/useragent.ui:204
#, kde-format
msgid "Use &default identification"
msgstr "Koristi podrazu&mevanu identifikaciju"

