#: kserviceselectdlg.cpp:26
#, kde-format
msgid "Add Service"
msgstr "Aggiungi servizio"

#: kserviceselectdlg.cpp:30
#, kde-format
msgid "Select service:"
msgstr "Seleziona servizio:"

#: newtypedlg.cpp:25
#, kde-format
msgid "Create New File Type"
msgstr "Crea nuovo tipo di file"

#: newtypedlg.cpp:30
#, kde-format
msgid "Group:"
msgstr "Gruppo:"

#: newtypedlg.cpp:39
#, kde-format
msgid "Select the category under which the new file type should be added."
msgstr ""
"Seleziona la categoria sotto la quale dovrà essere aggiunto il nuovo tipo di "
"file."

#: newtypedlg.cpp:44
#, kde-format
msgid "Type name:"
msgstr "Nome del tipo:"

#: newtypedlg.cpp:50
#, kde-format
msgid ""
"Type the name of the file type. For instance, if you selected 'image' as "
"category and you type 'custom' here, the file type 'image/custom' will be "
"created."
msgstr ""
"Scrivi il nome del tipo di file. Per esempio, se hai selezionato «image» "
"come categoria e qui scrivi «personalizzato», verrà creato il tipo di file "
"«image/personalizzato»."
