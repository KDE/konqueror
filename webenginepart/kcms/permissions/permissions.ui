     <property name="title">
      <string>Persistent permission policy</string>
     </property>
     <layout class="QVBoxLayout" name="verticalLayout_2">
      <item>
       <widget class="QComboBox" name="defaultPermissionPolicy">
        <property name="toolTip">
         <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;What to do when a page requires a permission:&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;ask every time&lt;/strong&gt;: ask every time the page requires the permission whether to grant or deny permission&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;only ask once per session&lt;/strong&gt;: only ask the first time the page requires the permission, then reuse the same answer until Konqueror is closed&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;only ask once&lt;/strong&gt;: only ask the first time the page requires the permission, then reuse the same answer&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;&lt;strong&gt;Note:&lt;/strong&gt; for security reasons, some permissions (for example, permission to access microphones or webcams) are always asked every time, regardless of this setting.&lt;/p&gt;
&lt;/body&gt;&lt;/html&gt;</string>
        </property>
        <item>
         <property name="text">
          <string>Ask every time</string>
